{
  "name": "fullstack-react-aws-iac",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "infrastructure",
    "shared"
  ],
  "scripts": {
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:build": "pnpm --filter frontend build",
    "backend:dev": "pnpm --filter backend dev",
    "backend:build": "pnpm --filter backend build",
    "infra:synth": "cd infrastructure && pnpm cdk synth", 
    "infra:deploy": "cd infrastructure && pnpm cdk deploy --all",
    "infra:destroy": "cd infrastructure && pnpm cdk destroy --all",
    "build:all": "pnpm backend:build && pnpm frontend:build",
    "deploy": "pnpm build:all && pnpm infra:deploy"
  },
  "keywords": [],
  "author": "Enrique Gimenez",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0"
}
